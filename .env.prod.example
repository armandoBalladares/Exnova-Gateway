APP_ENV=prod
DEBUG=false
LOG_FORMAT=json
LOG_LEVEL=INFO
LOG_DIR=/var/log/exnova-gateway
CORS_ORIGINS=https://tu-frontend.ejemplo.com
# API_KEYS, EXNOVA_EMAIL y EXNOVA_PASSWORD -> SIEMPRE desde gestor de secretos / variables del orquestador
EXNOVA_ACCOUNT_TYPE=PRACTICE      # cambiar a REAL solo tras pruebas y aprobación formal
TRADING_ENABLED=false             # habilitar explícitamente cuando corresponda
ALLOW_REAL_TRADING=false          # true + EXNOVA_ACCOUNT_TYPE=REAL para operar con dinero real
MAX_TRADE_AMOUNT=5
