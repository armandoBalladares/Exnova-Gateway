# ===== Referencia de TODAS las variables =====
# Copia a .env.local / .env.dev / .env.staging / .env.prod según el entorno.
# IMPORTANTE: APP_ENV debe definirse en la shell/Docker (export APP_ENV=dev), porque decide
#             qué archivo .env.<entorno> se carga. Precedencia: .env < .env.<APP_ENV> < variables del SO.

# --- Aplicación ---
APP_ENV=local              # local | dev | staging | prod
DEBUG=false                # prohibido en staging/prod
API_PREFIX=/api/v1
CORS_ORIGINS=              # separados por coma; vacío = CORS desactivado

# --- Seguridad de la API: "nombre:clave,nombre2:clave2" (el nombre queda en los logs de auditoría) ---
# Obligatorio en staging/prod. Genera claves con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# --- Exnova ---
EXNOVA_EMAIL=
EXNOVA_PASSWORD=           # en prod: inyectar desde un gestor de secretos, NO en el archivo
EXNOVA_ACCOUNT_TYPE=PRACTICE   # PRACTICE | REAL (REAL exige ALLOW_REAL_TRADING=true y APP_ENV=prod)
EXNOVA_AUTO_CONNECT=true
EXNOVA_RECONNECT_ATTEMPTS=3
EXNOVA_RECONNECT_DELAY_SECONDS=2

# --- Guardarraíles de trading ---
TRADING_ENABLED=false      # interruptor general: con false, ninguna orden sale al broker
ALLOW_REAL_TRADING=false   # solo puede ser true con APP_ENV=prod
MAX_TRADE_AMOUNT=10        # monto máximo por orden

# --- Logs / Auditoría ---
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json            # json | console
LOG_DIR=logs
LOG_MAX_BYTES=10485760     # 10 MB por archivo
LOG_BACKUP_COUNT=10
